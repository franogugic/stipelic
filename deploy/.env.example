# Compose variables for docker-compose.prod.yml. Copy to .env next to it, fill in, chmod 600. Never commit .env.

# Image tag deployed (the git short SHA the images were built from).
LUMA_TAG=
# Registry paths, once the images are pushed to a registry (chapter 10). Unset = the local image names.
LUMA_BACKEND_IMAGE=luma-backend
LUMA_WEB_IMAGE=luma-web

# The public host name; its DNS A/AAAA records must point at this server before the first start (Let's Encrypt).
LUMA_DOMAIN=
# Let's Encrypt account email (expiry and problem notices).
ACME_EMAIL=

# Hex only (openssl rand -hex 32): the passwords go into connection strings, where ";" or "," would break them.
POSTGRES_DB=luma
POSTGRES_USER=luma
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# The edge network. Change both only if 172.31.250.0/24 collides with a network the server already uses.
EDGE_SUBNET=172.31.250.0/24
PROXY_IP=172.31.250.10
