# Application settings for the API and the Worker (env_file in docker-compose.prod.yml). Copy to luma.env, fill in,
# chmod 600. Never commit luma.env. "__" is the configuration section separator (Email__FromAddress = Email:FromAddress).
#
# Set by docker-compose.prod.yml itself, not here: the environment name, ConnectionStrings__Database, Redis__*,
# ForwardedHeaders__*, Database__AutoMigrate=false, the JSON console logger.
# Replace every https://example.com with the real origin (https://<LUMA_DOMAIN>, no trailing slash).

# --- Auth (same origin as the web app) ---
Auth__SessionCookieSecure=true
Auth__SessionCookieSameSite=Lax

# --- Stripe (live mode): two webhook endpoints, https://example.com/webhooks/stripe and .../webhooks/stripe/connect ---
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__ConnectWebhookSecret=
Stripe__FrontendBaseUrl=https://example.com
Stripe__SuccessUrl=
Stripe__CancelUrl=
Stripe__BillingPortalReturnUrl=

# --- Orders ---
Orders__FrontendBaseUrl=https://example.com

# --- Email (API queues, Worker sends). The Worker's appsettings.json points FrontendBaseUrl at localhost: override it. ---
Email__Provider=Acs
Email__ConnectionString=
Email__FromAddress=
Email__FrontendBaseUrl=https://example.com
Email__LogoUrl=https://example.com/email/luma-mark-112.png
Email__HelpUrl=
Email__PrivacyUrl=
Email__SupportEmail=
# The sending quota PER WORKER INSTANCE (README: "Email sending"). ACS custom domain defaults; raise them after the quota
# increase, divided by the number of Worker replicas.
Email__Outbox__MaxSendsPerMinute=30
Email__Outbox__MaxSendsPerHour=100

# --- Marketing: three separate HMAC secrets (openssl rand -hex 32 each), the SAME values for the API and the Worker ---
Marketing__UnsubscribeTokenSecret=
Marketing__OpenTrackingSecret=
Marketing__ClickTrackingSecret=
Marketing__ApiBaseUrl=https://example.com
Marketing__FrontendBaseUrl=https://example.com

# --- Media (Azure Blob): public images and the private product-files container ---
Media__ConnectionString=
Media__ContainerName=
Media__PrivateContainerName=product-files

# --- Payouts ---
Payouts__AdminNotificationEmail=

# --- Hosts (PR 1): the API's host names (";"-separated; the proxy's health probe sends LUMA_DOMAIN) and the web app's
# origin. Same registrable domain for both (the session cookie is SameSite=Lax). See README "Hosts, CORS". ---
AllowedHosts=example.com
Cors__AllowedOrigins__0=https://example.com
